[
  {
    "id": "main",
    "components": [
      "section"
    ]
  },
  {
    "...": "./_section.json#/filters"
  },
  {
    "...": "../blocks/*/_*.json#/filters"
  },
  {
    "id": "text",
    "rte": {
      "toolbar": {
        "format": ["bold", "italic", "underline", "strike"],
        "alignment": [],
        "indentation": [],
        "blocks": [],
        "list": ["bullet_list", "ordered_list"],
        "insert": ["link", "unlink", "table"],
        "sr_script": ["superscript", "subscript"],
        "editor": ["removeformat"]
      },
      "actions": {
        "bold": {
          "tag": "strong",
          "shortcut": "Mod-B",
          "label": "Bold"
        },
        "italic": {
          "tag": "em",
          "shortcut": "Mod-I",
          "label": "Italic"
        },
        "strike": {
          "tag": "del"
        },
        "bullet_list": {
          "wrapInParagraphs": true,
          "shortcut": "Mod-Shift-8",
          "label": "Bullet List"
        },
        "ordered_list": {
          "wrapInParagraphs": true,
          "shortcut": "Mod-Shift-9",
          "label": "Ordered List"
        },
        "link": {
          "hideTarget": false,
          "shortcut": "Mod-K",
          "label": "Insert Link"
        },
        "unlink": {
          "shortcut": "Mod-Shift-K",
          "label": "Remove Link"
        },
        "table": {
          "wrapInParagraphs": false,
          "shortcut": "Mod-Alt-T",
          "label": "Insert Table"
        }
      }
    },
    "components": [
      "richtext"
    ]
  }
]
